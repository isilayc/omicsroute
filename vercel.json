{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python build_vercel.py",
  "functions": {
    "api/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/**,tests/**,audit/**,backups/**,.venv/**,.git/**,app.py,*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
